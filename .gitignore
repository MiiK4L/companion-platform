# ============================================================
# Companion Platform — .gitignore
# ============================================================

# --- ESP-IDF / CMake ---
build/
sdkconfig.old
managed_components/
dependencies.lock
.cache/
compile_commands.json
*.elf
*.bin
*.map

# --- KiCad ---
*-bak
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups/
fp-info-cache
*.lck
*~
_autosave-*

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
site/
.mypy_cache/
.pytest_cache/
*.egg-info/

# --- Node ---
node_modules/
npm-debug.log*
yarn-error.log*

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- Éditeurs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/

# --- Divers ---
*.log
*.tmp
