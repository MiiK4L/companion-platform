{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archive index",
  "description": "Index des empreintes SHA-256 de TOUS les artefacts immuables du run (vue derivee, recalculable).",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
