{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campaign definition",
  "description": "Description d'une campagne (baselinable) : question observable, verdict attendu, protocole, DUT vise, acquisition. Sans champ volatil ni metadonnee d'execution.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "experiment_id",
    "experimental_question",
    "expected_observation",
    "verdict_rule",
    "protocol_ref",
    "dec",
    "dut",
    "acquisition"
  ],
  "properties": {
    "experiment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "experimental_question": { "type": "string" },
    "expected_observation": { "type": "string" },
    "verdict_rule": { "type": "string" },
    "protocol_ref": { "type": "string" },
    "dec": { "type": "string" },
    "dut": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" }
      }
    },
    "parameters": { "type": "object" },
    "acquisition": {
      "type": "object",
      "required": ["driver"],
      "properties": {
        "driver": { "type": "string" },
        "config": { "type": "object" }
      }
    }
  }
}
