{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run manifest",
  "description": "Resultat d'une execution : identite, references (hashes) vers definition/contexte, statut de preuve, verdict, artefacts. Champs volatils: run_id, generated_at.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "campaign_definition_id",
    "definition_sha256",
    "context_sha256",
    "run_id",
    "generated_at",
    "acquisition_nature",
    "evidence_status",
    "verdict",
    "verdict_reason",
    "protocol_ref",
    "dec",
    "tooling_version",
    "artifacts"
  ],
  "properties": {
    "experiment_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "campaign_definition_id": { "type": "string" },
    "definition_sha256": { "type": "string" },
    "context_sha256": { "type": "string" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "generated_at": { "type": "string" },
    "acquisition_nature": { "type": "string", "enum": ["measured", "simulated"] },
    "evidence_status": { "type": "string", "enum": ["RAW", "REVIEWED", "M", "S"] },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "INCONCLUSIVE", "INVALID", "NOT_RUN"]
    },
    "verdict_reason": { "type": "string" },
    "protocol_ref": { "type": "string" },
    "dec": { "type": "string" },
    "tooling_version": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    }
  }
}
